# === Dependencies ===
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/
env/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# === Build Outputs ===
dist/
build/
target/
*.egg-info/
out/
.turbo/

# === Runtime Local Storage (NEVER commit raw or metadata files) ===
/storage/
services/storage/uploads/

# === Environment & Local Configs ===
.env
.env.local
.env.*.local
*.private.json
encrypted-config/

# === IDE & System Files ===
.vscode/
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
*.lsu
.DS_Store
Thumbs.db
desktop.ini

# === Tauri Specific ===
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Scratch / Debug Scripts ===
scratch/
tools/_archive_root_scripts/

# === Large installer binaries (download via README_SETUP.txt instead) ===
tools/installer/*.exe
