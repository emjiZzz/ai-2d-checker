# === Dependencies ===
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/
env/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# === Build Outputs ===
dist/
build/
target/
*.egg-info/
out/
.turbo/
msvc/
downloads/

# === Runtime Local Storage (NEVER commit raw or metadata files) ===
/storage/
services/storage/uploads/
# The `/storage/` rule above is anchored to the repo root, so it does NOT cover the
# backend's own storage tree — which is how services/backend/storage/secure/.api-token
# came to be committed. That token is generated at startup by
# core/security.py::initialize_local_api_token and regenerates if absent.
services/backend/storage/

# === Environment & Local Configs ===
.env
.env.local
.env.*.local
*.private.json
encrypted-config/

# === IDE & System Files ===
.vscode/
.idea/
*.swp
*.suo
.ntvs
*.njsproj
*.sln
*.lsu
.DS_Store
Thumbs.db
desktop.ini

# === Tauri Specific ===
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Scratch / Debug Scripts ===
scratch/
tools/_archive_root_scripts/

# === Large installer binaries (download via README_SETUP.txt instead) ===
tools/installer/*.exe

Prompt-Engineering-OS/

