# ==============================================================================
# AI-2D-Checker — Environment Template
# Copy this file to `.env` in the root folder and configure values.
# ==============================================================================

# MongoDB Configuration
# For local offline-first usage, defaults should point to local MongoDB Community Server.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_2d_checker

# AI Core Configuration
# The Gemini API key. The application will encrypt this on first startup 
# using OS-level secure storage (Windows DPAPI / Keychain).
# Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-flash-latest

# OpenAI API Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-5.4

# Storage & File Handlers
# Absolute or relative path to the git-ignored local storage hierarchy.
STORAGE_ROOT=./storage
MAX_FILE_SIZE_MB=500

# ODA File Converter Installation Path
# Required for converting proprietary DWG drawings to open DXF.
# Download from: https://www.opendesign.com/guestfiles/oda_file_converter
ODA_CONVERTER_PATH=C:/Program Files/ODA/ODAFileConverter_25.12.0/ODAFileConverter.exe

# Sidecar Server Configuration
# Set SIDECAR_PORT to 0 to dynamically allocate a port at startup.
SIDECAR_PORT=0
SIDECAR_LOG_LEVEL=INFO
SIDECAR_HOST=127.0.0.1
