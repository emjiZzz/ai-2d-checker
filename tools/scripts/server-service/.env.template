# ==============================================================================
# KMTI 2D Checker - per-workstation backend (sidecar)
# ==============================================================================
# Copied to `.env` by install-service.ps1 on FIRST install only, so an edit made
# on a particular machine survives an upgrade.

# Loopback on purpose. This backend serves only the desktop app on THIS machine,
# so it must not be reachable from the network.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080
SIDECAR_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database: MongoDB Atlas, reached directly from each workstation.
#
# Uploaded drawings do NOT go here - they stay in this machine's own
# storage/uploads folder, which is the per-engineer privacy the sidecar exists
# for. What converges in Atlas is the ground truth: rooms, sessions, markings.
#
# THIS FILE SHIPS INSIDE THE INSTALLER, ON EVERY WORKSTATION.
#
# The connection string below is substituted at package time from the build
# machine's .env, so it is a REAL CREDENTIAL sitting in an archive anyone holding
# the installer can extract. Before distributing widely, replace it with an Atlas
# user scoped to readWrite on `ai_2d_checker` only, ideally with an IP allowlist
# for the office range - so a leaked installer costs one scoped user rather than
# the cluster.
# ------------------------------------------------------------------------------
MONGO_URI=__MONGO_URI__
MONGO_DB_NAME=ai_2d_checker

# Deliberately the SAME as MONGO_URI.
#
# The default fallback is mongodb://127.0.0.1:27017 - a DIFFERENT database. If
# Atlas were briefly unreachable, the backend would quietly succeed against a
# local instance and that machine's markings would accumulate somewhere nobody
# collects. Pointing the fallback at the same place turns an outage into a
# visible failure instead of a silent fork.
MONGO_FALLBACK_URI=__MONGO_URI__

# Nothing to sync: there is no local/cloud pair, just Atlas.
ENABLE_DB_AUTO_SYNC=false
